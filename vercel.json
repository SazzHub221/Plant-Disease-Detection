{
  "version": 2,
  "buildCommand": "set NODE_OPTIONS=--openssl-legacy-provider && npm run build && serve -s build",
  "outputDirectory": "build",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "env": {
    "REACT_APP_API_URL": "https://plant-disease-detection-yz5v.onrender.com/predict"
  }
}