{
  "version": 2,
  "buildCommand": "npm run build && npm start",
  "outputDirectory": "build",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "env": {
    "REACT_APP_API_URL": "https://plant-disease-detection-yz5v.onrender.com/predict",
    "NODE_OPTIONS": "--openssl-legacy-provider"
  }
}